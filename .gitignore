```gitignore
# Environment variables
.env
.env.local
.env.development
.env.production
.env.test

# Node modules
node_modules/

# React build
build/
dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Docker
docker-compose.override.yml

# Temporary files
*.tmp
*.temp
```
